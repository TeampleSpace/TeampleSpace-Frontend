{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-3-design.schema.json",
  "title": "TeampleSpace 디자인 설정 계약",
  "$defs": {
    "TemplateCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "allowedFonts", "allowedLayouts"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/Template" } },
        "allowedFonts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "allowedLayouts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "projectFontsEnabled": { "type": "boolean" }
      }
    },
    "Template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "key", "version", "name", "schemaVersion", "preview", "fonts", "layouts"],
      "properties": {
        "id": { "$ref": "api.schema.json#/$defs/Uuid" },
        "key": { "type": "string", "minLength": 1, "maxLength": 64 },
        "version": { "$ref": "api.schema.json#/$defs/Version" },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "preview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backgroundColor", "headingColor", "description"],
          "properties": {
            "backgroundColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "headingColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "description": { "type": "string" }
          }
        },
        "fonts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "layouts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "ProjectFontList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/ProjectFont" } }
      }
    },
    "ProjectFont": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fileName", "format", "sizeBytes", "contentUrl"],
      "properties": {
        "id": { "$ref": "api.schema.json#/$defs/Uuid" },
        "fileName": { "type": "string", "minLength": 5, "maxLength": 255 },
        "format": { "enum": ["ttf", "otf"] },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 5242880 },
        "contentUrl": { "type": "string", "pattern": "^/v1/projects/[a-f0-9-]+/design-fonts/[a-f0-9-]+/content$" }
      }
    },
    "DesignSettingsPutRequest": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["expectedVersion", "mode", "templateId", "templateVersion"],
          "properties": {
            "expectedVersion": { "$ref": "api.schema.json#/$defs/Version" },
            "mode": { "const": "template" },
            "templateId": { "$ref": "api.schema.json#/$defs/Uuid" },
            "templateVersion": { "$ref": "api.schema.json#/$defs/Version" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["expectedVersion", "mode", "custom"],
          "properties": {
            "expectedVersion": { "$ref": "api.schema.json#/$defs/Version" },
            "mode": { "const": "custom" },
            "custom": { "$ref": "api.schema.json#/$defs/DesignCustom" }
          }
        }
      ]
    },
    "TemplatePreview": {
      "description": "템플릿으로 그린 예시 발표. 발표 생성과 같은 배치 규칙을 쓴다",
      "type": "object",
      "additionalProperties": false,
      "required": ["templateId", "templateVersion", "canvas", "slides"],
      "properties": {
        "templateId": { "$ref": "api.schema.json#/$defs/Uuid" },
        "templateVersion": { "$ref": "api.schema.json#/$defs/Version" },
        "canvas": { "$ref": "document.schema.json#/$defs/Canvas" },
        "slides": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/TemplatePreviewSlide" } }
      }
    },
    "TemplatePreviewSlide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layoutId", "elements"],
      "properties": {
        "layoutId": { "type": "string", "maxLength": 64 },
        "elements": { "type": "array", "items": { "$ref": "#/$defs/TemplatePreviewElement" } }
      }
    },
    "TemplatePreviewElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "geometry", "content", "style"],
      "properties": {
        "type": { "enum": ["text", "shape", "image"] },
        "geometry": { "$ref": "document.schema.json#/$defs/Geometry" },
        "content": { "type": "object" },
        "style": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "text" } } },
          "then": { "properties": { "content": { "$ref": "document.schema.json#/$defs/TextContent" }, "style": { "$ref": "document.schema.json#/$defs/TextStyle" } } }
        },
        {
          "if": { "properties": { "type": { "const": "shape" } } },
          "then": { "properties": { "content": { "$ref": "document.schema.json#/$defs/ShapeContent" }, "style": { "$ref": "document.schema.json#/$defs/ShapeStyle" } } }
        },
        {
          "if": { "properties": { "type": { "const": "image" } } },
          "then": { "properties": { "content": { "$ref": "document.schema.json#/$defs/ImageContent" }, "style": { "$ref": "document.schema.json#/$defs/ImageStyle" } } }
        }
      ]
    }
  }
}
