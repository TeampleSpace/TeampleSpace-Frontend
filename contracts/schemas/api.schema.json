{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api.schema.json",
  "title": "TeampleSpace /v1 공통 요청과 응답 형식",
  "$defs": {
    "Uuid": { "$ref": "document.schema.json#/$defs/Uuid" },
    "Timestamp": { "$ref": "document.schema.json#/$defs/Timestamp" },
    "Version": { "$ref": "document.schema.json#/$defs/Version" },
    "EventCursor": {
      "description": "프로젝트 이벤트 순번의 십진 문자열. 클라이언트는 해석하지 않고 그대로 돌려준다",
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "ClientMutationId": {
      "description": "화면과 이벤트를 잇는 상관관계 값. 멱등키를 대신하지 않는다",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },

    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "requestId"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "message": { "type": "string" },
            "retryable": { "type": "boolean" },
            "fieldErrors": {
              "type": "array",
              "items": { "$ref": "#/$defs/FieldError" }
            },
            "currentVersions": { "$ref": "#/$defs/CurrentVersions" }
          }
        },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "FieldError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "code", "message"],
      "properties": {
        "field": { "type": "string" },
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "CurrentVersions": {
      "description": "충돌 시 서버의 현재 버전. 서로 다른 범위의 값을 비교하지 않는다",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "userVersion": { "$ref": "#/$defs/Version" },
        "projectVersion": { "$ref": "#/$defs/Version" },
        "membershipVersion": { "$ref": "#/$defs/Version" },
        "materialVersion": { "$ref": "#/$defs/Version" },
        "outlineVersion": { "$ref": "#/$defs/Version" },
        "designVersion": { "$ref": "#/$defs/Version" },
        "generation": { "$ref": "#/$defs/Version" },
        "presentationVersion": { "$ref": "#/$defs/Version" },
        "orderVersion": { "$ref": "#/$defs/Version" },
        "slideVersion": { "$ref": "#/$defs/Version" },
        "elementVersion": { "$ref": "#/$defs/Version" },
        "elementVersions": {
          "description": "여러 요소를 다루는 요청에서 요소 식별자별 현재 버전",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/Version" }
        },
        "noteVersion": {
          "description": "자료 팀 메모의 현재 버전. 아직 쓰지 않은 메모는 0이다",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },

    "ElementPatchRequest": {
      "description": "요소 수정 요청 본문. Idempotency-Key 헤더가 필수다",
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "baseVersion", "editGroupId", "clientMutationId"],
      "properties": {
        "generation": { "$ref": "#/$defs/Version" },
        "baseVersion": { "description": "마지막으로 서버가 확인해 준 요소 버전", "$ref": "#/$defs/Version" },
        "editGroupId": { "$ref": "#/$defs/Uuid" },
        "clientMutationId": { "$ref": "#/$defs/ClientMutationId" },
        "finalizeGroup": { "type": "boolean" },
        "patch": { "$ref": "#/$defs/ElementPatch" }
      },
      "anyOf": [
        { "required": ["patch"] },
        { "required": ["finalizeGroup"], "properties": { "finalizeGroup": { "const": true } } }
      ]
    },
    "SlideCreateRequest": {
      "description": "슬라이드 추가 요청 본문. Idempotency-Key 헤더가 필수다",
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "orderVersion", "clientMutationId", "slideId"],
      "properties": {
        "generation": { "$ref": "#/$defs/Version" },
        "orderVersion": { "description": "클라이언트가 아는 슬라이드 목록 버전", "$ref": "#/$defs/Version" },
        "clientMutationId": { "$ref": "#/$defs/ClientMutationId" },
        "slideId": { "description": "클라이언트가 만든 새 슬라이드 식별자", "$ref": "#/$defs/Uuid" },
        "afterSlideId": {
          "description": "이 슬라이드 바로 뒤에 넣는다. null이거나 없으면 맨 앞에 넣는다",
          "anyOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }]
        },
        "layoutId": { "type": ["string", "null"], "maxLength": 64 }
      }
    },
    "SlideDeleteRequest": {
      "description": "슬라이드 삭제 요청 본문. Idempotency-Key 헤더가 필수다",
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "orderVersion", "clientMutationId"],
      "properties": {
        "generation": { "$ref": "#/$defs/Version" },
        "orderVersion": { "description": "클라이언트가 아는 슬라이드 목록 버전", "$ref": "#/$defs/Version" },
        "clientMutationId": { "$ref": "#/$defs/ClientMutationId" }
      }
    },
    "SlideOrderRequest": {
      "description": "슬라이드 순서 변경 요청 본문. Idempotency-Key 헤더가 필수다",
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "orderVersion", "clientMutationId", "slideIds"],
      "properties": {
        "generation": { "$ref": "#/$defs/Version" },
        "orderVersion": { "description": "클라이언트가 아는 슬라이드 목록 버전", "$ref": "#/$defs/Version" },
        "clientMutationId": { "$ref": "#/$defs/ClientMutationId" },
        "slideIds": {
          "description": "바꾼 뒤의 전체 순서. 지금 있는 슬라이드를 빠짐없이 한 번씩 담는다",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Uuid" }
        }
      }
    },
    "ElementCreateRequest": {
      "description": "요소 추가 요청 본문. Idempotency-Key 헤더가 필수다",
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "clientMutationId", "element"],
      "properties": {
        "generation": { "$ref": "#/$defs/Version" },
        "clientMutationId": { "$ref": "#/$defs/ClientMutationId" },
        "element": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "geometry", "content", "style"],
          "properties": {
            "id": { "description": "클라이언트가 만든 새 요소 식별자", "$ref": "#/$defs/Uuid" },
            "type": { "description": "이미지는 파일을 확정해 연결하는 경로가 생길 때 연다", "enum": ["text", "shape"] },
            "geometry": { "$ref": "document.schema.json#/$defs/Geometry" },
            "content": { "type": "object" },
            "style": { "type": "object" }
          }
        }
      }
    },
    "ElementDeleteRequest": {
      "description": "요소 삭제 요청 본문. Idempotency-Key 헤더가 필수다",
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "baseVersion", "clientMutationId"],
      "properties": {
        "generation": { "$ref": "#/$defs/Version" },
        "baseVersion": { "description": "마지막으로 서버가 확인해 준 요소 버전", "$ref": "#/$defs/Version" },
        "clientMutationId": { "$ref": "#/$defs/ClientMutationId" }
      }
    },
    "ElementPatch": {
      "description": "보낸 항목만 바꾼다. 각 항목은 통째로 교체된다",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "geometry": { "$ref": "document.schema.json#/$defs/Geometry" },
        "content": { "type": "object" },
        "style": { "type": "object" },
        "sourceRefs": {
          "type": "array",
          "items": { "$ref": "document.schema.json#/$defs/SourceRef" }
        }
      }
    },

    "DocumentChange": {
      "description": "문서 변경 응답과 이벤트 payload가 함께 쓰는 항목",
      "type": "object",
      "properties": {
        "resource": {
          "anyOf": [
            { "$ref": "document.schema.json#/$defs/Element" },
            { "$ref": "document.schema.json#/$defs/Slide" }
          ]
        },
        "tombstone": { "$ref": "#/$defs/Tombstone" },
        "elementVersion": { "$ref": "#/$defs/Version" },
        "slideVersion": { "$ref": "#/$defs/Version" },
        "presentationVersion": { "$ref": "#/$defs/Version" },
        "orderVersion": { "$ref": "#/$defs/Version" },
        "generation": { "$ref": "#/$defs/Version" },
        "changeId": { "$ref": "#/$defs/Uuid" },
        "slideIds": {
          "description": "슬라이드 추가, 삭제, 순서 변경 뒤의 전체 순서",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Uuid" }
        }
      },
      "not": { "required": ["resource", "tombstone"] },
      "anyOf": [
        { "required": ["resource"] },
        { "required": ["tombstone"] },
        { "required": ["slideIds"] }
      ]
    },
    "Tombstone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceType", "id", "deletedAt"],
      "properties": {
        "resourceType": { "enum": ["element", "slide"] },
        "id": { "$ref": "#/$defs/Uuid" },
        "version": { "$ref": "#/$defs/Version" },
        "deletedAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "MutationResponse": {
      "description": "문서 변경 성공 응답. 같은 멱등키 재시도에는 처음과 같은 응답을 돌려준다",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/DocumentChange" }],
      "required": ["clientMutationId", "eventId"],
      "properties": {
        "clientMutationId": { "$ref": "#/$defs/ClientMutationId" },
        "eventId": { "$ref": "#/$defs/EventCursor" }
      },
      "unevaluatedProperties": false
    },

    "SlideRevisionRequest": {
      "description": "슬라이드 하나의 AI 수정 작업 등록 요청. generation은 편집 중인 문서 세대다",
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "prompt"],
      "properties": {
        "generation": { "$ref": "#/$defs/Version" },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "SlideRevisionResult": {
      "description": "slide_revision 작업이 성공하면 resultRef에 담기는 수정 제안. 적용 전에는 문서를 바꾸지 않는다. 제안 식별자는 작업 식별자다",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "slideId", "generation", "targets"],
      "properties": {
        "type": { "const": "slide_revision" },
        "slideId": { "$ref": "#/$defs/Uuid" },
        "generation": { "$ref": "#/$defs/Version" },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["elementId", "baseVersion", "before", "after"],
            "properties": {
              "elementId": { "$ref": "#/$defs/Uuid" },
              "baseVersion": { "$ref": "#/$defs/Version" },
              "before": { "type": "string" },
              "after": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "SlideRevisionApplied": {
      "description": "수정 제안 적용 결과. 대상마다 요소 수정과 같은 변경 응답이 온다",
      "type": "object",
      "additionalProperties": false,
      "required": ["proposalId", "changes"],
      "properties": {
        "proposalId": { "$ref": "#/$defs/Uuid" },
        "changes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/MutationResponse" } }
      }
    },

    "Event": {
      "description": "이벤트 구독으로 전달하는 봉투. SSE의 id는 eventId, event는 type이다",
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "projectId", "type", "occurredAt", "payload"],
      "properties": {
        "eventId": { "$ref": "#/$defs/EventCursor" },
        "projectId": { "$ref": "#/$defs/Uuid" },
        "type": { "$ref": "#/$defs/EventType" },
        "actorId": { "anyOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }] },
        "clientMutationId": { "$ref": "#/$defs/ClientMutationId" },
        "occurredAt": { "$ref": "#/$defs/Timestamp" },
        "resourceId": { "$ref": "#/$defs/Uuid" },
        "resourceVersion": { "$ref": "#/$defs/Version" },
        "presentationVersion": { "$ref": "#/$defs/Version" },
        "generation": { "$ref": "#/$defs/Version" },
        "payload": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["element.updated", "element.deleted"] } } },
          "then": { "properties": { "payload": { "$ref": "#/$defs/DocumentChange" } } }
        },
        {
          "description": "문서 버전을 올리는 이벤트는 문서 버전과 세대를 싣는다. 클라이언트가 빠진 변경을 알아채는 기준이다",
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "element.updated",
                  "element.deleted",
                  "slide.created",
                  "slide.deleted",
                  "slide.order.updated",
                  "presentation.replaced"
                ]
              }
            }
          },
          "then": { "required": ["presentationVersion", "generation"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["change.created", "change.finalized"] } } },
          "then": {
            "required": ["resourceId"],
            "properties": { "payload": { "$ref": "#/$defs/ChangeGroupPayload" } }
          }
        }
      ]
    },
    "ChangeGroupPayload": {
      "description": "변경 묶음이 생기거나 닫혔음을 알리는 이벤트의 payload. resourceId도 같은 변경 식별자다",
      "type": "object",
      "required": ["changeId", "groupState"],
      "properties": {
        "changeId": { "$ref": "#/$defs/Uuid" },
        "groupState": { "enum": ["open", "closed"] }
      }
    },
    "EventType": {
      "enum": [
        "project.updated",
        "project.deleted",
        "membership.changed",
        "material.updated",
        "material.deleted",
        "material.note.updated",
        "material.comment.created",
        "material.comment.deleted",
        "request.created",
        "request.updated",
        "outline.updated",
        "design.updated",
        "presentation.replaced",
        "slide.created",
        "slide.deleted",
        "slide.order.updated",
        "element.updated",
        "element.deleted",
        "change.created",
        "change.finalized",
        "review.updated",
        "comment.created",
        "job.updated",
        "export.ready",
        "presence.updated",
        "viewers.updated",
        "memo.updated",
        "memo.awareness"
      ]
    },
    "PresenceUpdateRequest": {
      "description": "편집 화면의 커서 위치. 좌표는 슬라이드 캔버스 px이고 slideId가 null이면 편집 화면을 떠난 것이다",
      "type": "object",
      "additionalProperties": false,
      "required": ["slideId"],
      "properties": {
        "slideId": { "anyOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }] },
        "x": { "type": "number", "minimum": -10000, "maximum": 10000 },
        "y": { "type": "number", "minimum": -10000, "maximum": 10000 }
      },
      "if": { "properties": { "slideId": { "type": "string" } } },
      "then": { "required": ["x", "y"] }
    },
    "ViewingRequest": {
      "description": "프로젝트 화면에서 지금 보는 탭. tab이 null이면 프로젝트 화면을 떠난 것이다",
      "type": "object",
      "additionalProperties": false,
      "required": ["tab"],
      "properties": {
        "tab": { "anyOf": [{ "$ref": "#/$defs/ProjectTab" }, { "type": "null" }] },
        "viewId": { "type": "string", "minLength": 1, "maxLength": 64, "description": "창마다 다른 값. 떠남은 그 창만 지우고 같은 사람의 다른 창은 남는다" },
        "seq": { "type": "integer", "minimum": 0, "description": "같은 창에서 보낼 때마다 늘리는 순번. 같은 viewId로 이미 받은 순번 이하의 알림은 버린다" }
      }
    },
    "ProjectTab": {
      "type": "string",
      "enum": ["overview", "materials", "outline", "design", "slides", "settings"]
    },
    "ViewersUpdated": {
      "description": "viewers.updated 신호의 data. 나를 뺀 팀원이 지금 보는 탭 전체 목록이며 SSE id 없이 바뀔 때만 온다",
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "viewers"],
      "properties": {
        "projectId": { "$ref": "#/$defs/Uuid" },
        "viewers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["userId", "tab"],
            "properties": {
              "userId": { "$ref": "#/$defs/Uuid" },
              "tab": { "$ref": "#/$defs/ProjectTab" }
            }
          }
        }
      }
    },
    "MemoUpdateRequest": {
      "description": "메모 편집기가 만든 변경 조각. data는 base64이고 initial이 true면 조각이 하나도 없을 때만 받는다",
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": { "type": "string", "minLength": 1 },
        "initial": { "type": "boolean" }
      }
    },
    "MemoUpdateCreated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq"],
      "properties": { "seq": { "type": "integer", "minimum": 1 } }
    },
    "MemoUpdateList": {
      "description": "after 다음 순번의 조각. hasMore가 true면 마지막 seq로 이어 읽는다",
      "type": "object",
      "additionalProperties": false,
      "required": ["updates", "hasMore"],
      "properties": {
        "updates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["seq", "data"],
            "properties": {
              "seq": { "type": "integer", "minimum": 1 },
              "data": { "type": "string", "minLength": 1 }
            }
          }
        },
        "hasMore": { "type": "boolean" }
      }
    },
    "MemoCompactRequest": {
      "description": "upTo까지의 조각을 모두 담은 한 덩어리. 서버는 upTo 이하 조각을 이 덩어리 하나로 바꾼다",
      "type": "object",
      "additionalProperties": false,
      "required": ["upTo", "data"],
      "properties": {
        "upTo": { "type": "integer", "minimum": 1 },
        "data": { "type": "string", "minLength": 1 }
      }
    },
    "MemoUpdated": {
      "description": "memo.updated 신호의 data. 같은 프로젝트의 구독에 SSE id 없이 바로 넘긴다. 받은 seq가 아는 순번보다 2 이상 크면 목록 경로로 놓친 조각을 읽는다",
      "type": "object",
      "additionalProperties": false,
      "required": ["materialId", "seq", "data"],
      "properties": {
        "materialId": { "$ref": "#/$defs/Uuid" },
        "seq": { "type": "integer", "minimum": 1 },
        "data": { "type": "string", "minLength": 1 }
      }
    },
    "MemoAwarenessRequest": {
      "description": "메모 편집기의 커서와 선택 영역 상태. data는 base64이고 저장하지 않는다",
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": { "data": { "type": "string", "minLength": 1 } }
    },
    "MemoAwareness": {
      "description": "memo.awareness 신호의 data. 같은 프로젝트의 구독에 SSE id 없이 바로 넘기고 다시 받을 수 있다고 보장하지 않는다",
      "type": "object",
      "additionalProperties": false,
      "required": ["materialId", "data"],
      "properties": {
        "materialId": { "$ref": "#/$defs/Uuid" },
        "data": { "type": "string", "minLength": 1 }
      }
    },
    "PresenceUpdated": {
      "description": "presence.updated 신호의 data. 나를 뺀 팀원의 현재 커서 전체 목록이며 SSE id 없이 바뀔 때만 온다",
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "cursors"],
      "properties": {
        "projectId": { "$ref": "#/$defs/Uuid" },
        "cursors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["userId", "slideId", "x", "y"],
            "properties": {
              "userId": { "$ref": "#/$defs/Uuid" },
              "slideId": { "$ref": "#/$defs/Uuid" },
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          }
        }
      }
    },
    "SnapshotRequired": {
      "description": "커서가 보관 범위 밖이거나 유효하지 않을 때 보내는 신호. 받으면 동기화 스냅샷을 다시 읽는다",
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId"],
      "properties": {
        "projectId": { "$ref": "#/$defs/Uuid" }
      }
    },

    "Job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "status", "progress", "createdAt", "updatedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "projectId": { "$ref": "#/$defs/Uuid" },
        "type": { "type": "string", "minLength": 1, "maxLength": 32 },
        "status": { "$ref": "#/$defs/JobStatus" },
        "progress": { "type": "integer", "minimum": 0, "maximum": 100 },
        "targetType": { "type": "string", "maxLength": 32 },
        "targetId": { "$ref": "#/$defs/Uuid" },
        "attempt": { "description": "내부 재시도마다 증가한다", "type": "integer", "minimum": 0 },
        "inputVersions": { "$ref": "#/$defs/CurrentVersions" },
        "resultRef": { "type": ["object", "null"] },
        "error": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
                "message": { "type": "string" },
                "retryable": { "type": "boolean" }
              }
            }
          ]
        },
        "cancelRequestedAt": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "createdAt": { "$ref": "#/$defs/Timestamp" },
        "updatedAt": { "$ref": "#/$defs/Timestamp" },
        "finishedAt": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] }
      }
    },
    "JobStatus": {
      "description": "succeeded, failed, canceled는 바뀌지 않는다. 내부 재시도는 running에서 queued로 돌아간다",
      "enum": ["queued", "running", "succeeded", "failed", "canceled"]
    },
    "JobList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "nextCursor"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/Job" } },
        "nextCursor": { "type": ["string", "null"] }
      }
    },

    "Capabilities": {
      "description": "비밀값 없는 전역 지원 정보",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authProviders",
        "configVersion",
        "policyRevision",
        "uploadTypes",
        "formats",
        "fonts",
        "featureFlags",
        "legalDocuments",
        "idempotencyRetentionSeconds",
        "listLimit"
      ],
      "properties": {
        "configVersion": { "type": "string", "minLength": 1 },
        "authProviders": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["provider", "enabled", "reauthEnabled"], "properties": {"provider": {"enum": ["email", "kakao", "naver", "google"]}, "enabled": {"type": "boolean"}, "reauthEnabled": {"type": "boolean"}}}},
        "policyRevision": { "type": "string", "minLength": 1 },
        "uploadTypes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "mimeType", "maxBytes"],
            "properties": {
              "kind": { "type": "string" },
              "mimeType": { "type": "string" },
              "maxBytes": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "formats": {
          "description": "실제 파일 검사를 통과한 내보내기 형식만 담는다",
          "type": "array",
          "items": { "enum": ["pptx", "pdf"] },
          "uniqueItems": true
        },
        "fonts": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "featureFlags": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        },
        "legalDocuments": {
          "description": "비어 있으면 가입 완료를 열지 않는다",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "version", "url"],
            "properties": {
              "type": { "type": "string" },
              "version": { "type": "string" },
              "url": { "type": "string" }
            }
          }
        },
        "idempotencyRetentionSeconds": { "type": "integer", "minimum": 1 },
        "listLimit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default", "max"],
          "properties": {
            "default": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },

    "AuthBootstrap": {
      "description": "세션 초기 정보. 응답은 캐시하지 않는다",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "csrfToken", "expiresAt"],
      "properties": {
        "status": { "enum": ["anonymous", "authenticated"] },
        "csrfToken": { "type": "string", "minLength": 1 },
        "expiresAt": { "$ref": "#/$defs/Timestamp" },
        "user": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "displayName", "onboardingStatus", "version"],
          "properties": {
            "id": { "$ref": "#/$defs/Uuid" },
            "displayName": { "type": "string" },
            "onboardingStatus": { "type": "string" },
            "version": { "$ref": "#/$defs/Version" }
          }
        }
      },
      "if": { "properties": { "status": { "const": "authenticated" } } },
      "then": { "required": ["user"] },
      "else": { "not": { "required": ["user"] } }
    },

    "DesignCustom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "font", "primaryColor"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" },
        "font": { "type": "string", "minLength": 1 },
        "fontAssetId": { "$ref": "#/$defs/Uuid" },
        "primaryColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "guidelines": { "type": "string", "maxLength": 2000 }
      }
    },
    "DesignSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "mode", "templateId", "templateVersion", "custom", "updatedAt"],
      "properties": {
        "version": { "$ref": "#/$defs/Version" },
        "mode": { "enum": ["unset", "template", "custom"] },
        "templateId": { "anyOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }] },
        "templateVersion": { "anyOf": [{ "$ref": "#/$defs/Version" }, { "type": "null" }] },
        "custom": { "anyOf": [{ "$ref": "#/$defs/DesignCustom" }, { "type": "null" }] },
        "updatedAt": { "$ref": "#/$defs/Timestamp" }
      },
      "oneOf": [
        {
          "properties": {
            "mode": { "const": "unset" },
            "templateId": { "type": "null" },
            "templateVersion": { "type": "null" },
            "custom": { "type": "null" }
          }
        },
        {
          "properties": {
            "mode": { "const": "template" },
            "templateId": { "$ref": "#/$defs/Uuid" },
            "templateVersion": { "$ref": "#/$defs/Version" },
            "custom": { "type": "null" }
          }
        },
        {
          "properties": {
            "mode": { "const": "custom" },
            "templateId": { "type": "null" },
            "templateVersion": { "type": "null" },
            "custom": { "$ref": "#/$defs/DesignCustom", "required": ["guidelines"] }
          }
        }
      ]
    },

    "MaterialNote": {
      "description": "자료별 팀 공유 메모. 아직 쓰지 않은 메모는 version 0이다",
      "type": "object",
      "additionalProperties": false,
      "required": ["materialId", "markdown", "version", "updatedBy", "updatedByName", "updatedAt"],
      "properties": {
        "materialId": { "$ref": "#/$defs/Uuid" },
        "markdown": { "type": "string", "maxLength": 20000 },
        "version": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "updatedBy": { "anyOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }] },
        "updatedByName": { "description": "마지막으로 저장한 사람의 표시 이름", "type": ["string", "null"] },
        "updatedAt": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] }
      }
    },
    "MaterialNotePutRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedVersion", "markdown"],
      "properties": {
        "expectedVersion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "markdown": { "type": "string", "maxLength": 20000 }
      }
    },
    "MaterialNoteSaveResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materialId", "version", "eventId"],
      "properties": {
        "materialId": { "$ref": "#/$defs/Uuid" },
        "version": { "$ref": "#/$defs/Version" },
        "eventId": { "$ref": "#/$defs/EventCursor" }
      }
    },
    "ChangeRequestType": { "enum": ["outline_generation", "presentation_generation", "design_change"] },
    "ChangeRequestCreate": {
      "description": "payload는 type에 맞는 기존 요청 본문이다. outline_generation은 stage-3-generation의 OutlineJobRequest, presentation_generation은 PresentationGenerationRequest, design_change는 stage-3-design의 DesignSettingsPutRequest다",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "$ref": "#/$defs/ChangeRequestType" },
        "payload": { "type": "object" }
      }
    },
    "ChangeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "projectId", "type", "state", "payload", "requestedBy", "decidedBy", "result", "error", "createdAt", "decidedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "projectId": { "$ref": "#/$defs/Uuid" },
        "type": { "$ref": "#/$defs/ChangeRequestType" },
        "state": { "enum": ["pending", "approved", "failed", "rejected", "canceled"] },
        "payload": { "type": "object" },
        "requestedBy": { "$ref": "#/$defs/ChangeRequestPerson" },
        "decidedBy": { "anyOf": [{ "$ref": "#/$defs/ChangeRequestPerson" }, { "type": "null" }] },
        "result": {
          "description": "승인해 실행한 결과. 생성 요청은 jobId, 디자인 변경은 designVersion이다",
          "anyOf": [
            { "type": "object", "additionalProperties": false, "required": ["jobId"], "properties": { "jobId": { "$ref": "#/$defs/Uuid" } } },
            { "type": "object", "additionalProperties": false, "required": ["designVersion"], "properties": { "designVersion": { "$ref": "#/$defs/Version" } } },
            { "type": "null" }
          ]
        },
        "error": {
          "anyOf": [
            { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" } } },
            { "type": "null" }
          ]
        },
        "createdAt": { "$ref": "#/$defs/Timestamp" },
        "decidedAt": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] }
      }
    },
    "ChangeRequestPerson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId", "name"],
      "properties": { "userId": { "$ref": "#/$defs/Uuid" }, "name": { "type": "string" } }
    },
    "ChangeRequestList": {
      "description": "기다리는 요청을 먼저, 그다음 최근 요청부터 최대 50개를 담는다",
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": { "items": { "type": "array", "items": { "$ref": "#/$defs/ChangeRequest" } } }
    },
    "MaterialComment": {
      "description": "자료에 팀원이 남긴 댓글",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "materialId", "body", "author", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "materialId": { "$ref": "#/$defs/Uuid" },
        "body": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "required": ["userId", "name"],
          "properties": {
            "userId": { "$ref": "#/$defs/Uuid" },
            "name": { "type": "string" }
          }
        },
        "createdAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "MaterialCommentList": {
      "description": "오래된 댓글부터 담는다. nextCursor는 다음 페이지가 없으면 null이다",
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "nextCursor"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/MaterialComment" } },
        "nextCursor": { "type": ["string", "null"] }
      }
    },
    "MaterialCommentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body"],
      "properties": {
        "body": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "MaterialCommentDeleted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "materialId", "deleted"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "materialId": { "$ref": "#/$defs/Uuid" },
        "deleted": { "const": true }
      }
    },

    "SyncSnapshot": {
      "description": "화면에 필요한 데이터와 각 버전, 이벤트 커서를 같은 DB 시점에서 읽은 묶음",
      "type": "object",
      "required": ["scope", "projectId", "eventCursor"],
      "properties": {
        "scope": { "enum": ["editor", "composition", "workspace"] },
        "projectId": { "$ref": "#/$defs/Uuid" },
        "eventCursor": { "$ref": "#/$defs/EventCursor" }
      },
      "if": { "properties": { "scope": { "const": "editor" } } },
      "then": { "$ref": "#/$defs/EditorSnapshot" }
    },
    "EditorSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "projectId", "eventCursor", "presentation", "members", "designSettings", "activeJobs", "materials"],
      "properties": {
        "scope": { "const": "editor" },
        "projectId": { "$ref": "#/$defs/Uuid" },
        "eventCursor": { "$ref": "#/$defs/EventCursor" },
        "presentation": {
          "description": "아직 생성 전이면 null",
          "anyOf": [{ "$ref": "document.schema.json#/$defs/Presentation" }, { "type": "null" }]
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["userId", "displayName", "isOwner", "membershipVersion"],
            "properties": {
              "userId": { "$ref": "#/$defs/Uuid" },
              "displayName": { "type": "string" },
              "isOwner": { "type": "boolean" },
              "membershipVersion": { "$ref": "#/$defs/Version" }
            }
          }
        },
        "designSettings": { "$ref": "#/$defs/DesignSettings" },
        "activeJobs": { "type": "array", "items": { "$ref": "#/$defs/Job" } },
        "materials": {
          "description": "문서가 참조하는 자료의 요약. 본문은 담지 않는다",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "kind", "version", "deleted"],
            "properties": {
              "id": { "$ref": "#/$defs/Uuid" },
              "title": { "type": "string" },
              "kind": { "enum": ["file", "link", "memo"] },
              "version": { "$ref": "#/$defs/Version" },
              "deleted": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
